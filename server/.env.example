# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=your_database_name
PGUSER=postgres
PGPASSWORD=your_password

# Server Configuration
PORT=5000
JWT_SECRET=aiq_tracker_jwt_secret_key_2026

# Geoapify Routing Configuration (primary road distance & ETA provider)
# Register and get an API key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# TomTom Routing Configuration (traffic-aware routing evaluation)
# Register and get an API key at https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# OpenRouteService Routing Configuration (optional / legacy)
OPENROUTE_API_KEY=your_openrouteservice_api_key_here
